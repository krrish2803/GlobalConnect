# GlobalConnect Environment Configuration
# Nexconn Build Challenge 2026

# Server Port (default: 3000)
PORT=3000

# Disable one-click demo persona switching in non-production deployments.
# Demo login is automatically disabled when NODE_ENV=production.
DISABLE_DEMO_LOGIN=false

# Nexconn development credentials (leave empty until you rotate the values shared in chat).
# App Key may be exposed to the browser; App Secret must stay server-side.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE_URL=
NEXCONN_AREA_CODE=SG

# Use a unique secret for local webhook verification. Never use the public example value.
NEXCONN_WEBHOOK_SECRET=

# OpenAI API (optional; translation uses the curated corpus if omitted)
# The API key is server-only. Requests are capped at 10 per minute and cached in memory.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
